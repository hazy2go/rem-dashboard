{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rem Dashboard",
  "version": "1.0.0",
  "identifier": "ai.rem.dashboard",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Rem Dashboard",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src http://localhost:3001; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true
  }
}
